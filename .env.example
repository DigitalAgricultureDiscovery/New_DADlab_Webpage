# Optional local runtime settings. No AI API key is required.
PORT=3000
NODE_ENV=development
CMS_DATA_DIR=./data

# Production: use HTTPS and persistent private storage for CMS_DATA_DIR.
# SESSION_SECRET may be injected securely (at least 16 characters), or the app
# generates a secret file in CMS_DATA_DIR. Never commit a real secret.
# Provision the first admin with scripts/create-admin.ts using securely supplied
# CMS_ADMIN_EMAIL and CMS_ADMIN_PASSWORD; no default login is created.
